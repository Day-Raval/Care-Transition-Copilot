{
  "uid": "care-transition-copilot",
  "title": "Care Transition Copilot",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (route, status) (rate(care_transition_http_requests_total[5m]))"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(care_transition_http_request_duration_seconds_bucket[5m])))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP errors",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (route, status) (rate(care_transition_http_requests_total{status=~\"5..|4..\"}[5m]))"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Risk predictions",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [{"expr": "sum by (risk_category) (increase(care_transition_risk_predictions_total[1h]))"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agent runs",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "sum by (entrypoint, status) (rate(care_transition_agent_runs_total[5m]))"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM calls",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "sum by (agent, model, status) (rate(care_transition_llm_calls_total[5m]))"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM p95 latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, agent, model) (rate(care_transition_llm_call_duration_seconds_bucket[5m])))"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tool calls",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [{"expr": "sum by (tool, status) (rate(care_transition_agent_tool_calls_total[5m]))"}]
    }
  ]
}
