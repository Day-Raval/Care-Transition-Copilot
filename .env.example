# ── LLM Providers ────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Second model for the Plan Critique step — must be a different
# provider/model than GROQ_MODEL above, not just a different key
CRITIQUE_MODEL_PROVIDER=          #  Kimi | Qwen
CRITIQUE_MODEL_API_KEY=your_critique_model_api_key_here
CRITIQUE_MODEL_NAME= 

# ── Data Layer ───────────────────────────────────────────────
PERSISTENCE_BACKEND=local                         # local | database
DATABASE_URL=postgresql://copilot:change_me_random_password@localhost:5432/copilot_dev
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change_me_random_password
POSTGRES_DB=copilot_dev

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=discharge_notes

REDIS_URL=redis://localhost:6379/0               # local only; use TLS/authenticated Redis outside dev
REDIS_CACHE_TTL_SECONDS=3600

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092           # local only; use authenticated brokers outside dev
KAFKA_CLIENT_ID=care-transition-copilot
KAFKA_TOPIC_EPISODES=care-transition.discharge-episodes
KAFKA_TOPIC_AUDIT_EVENTS=care-transition.audit-events
KAFKA_MESSAGE_TIMEOUT_MS=5000

# ── Agent / Orchestration ────────────────────────────────────
LANGGRAPH_MAX_RETRIES=3
LANGGRAPH_TIMEOUT_SECONDS=30

# ── API Service ──────────────────────────────────────────────
API_HOST=127.0.0.1                               # use 0.0.0.0 only inside trusted containers/networks
API_PORT=8080
API_SECRET_KEY=replace_with_random_hex            # generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=replace_with_random_hex                   # local demo shared key; never expose this in production
PATIENT_REF_SALT=replace_with_random_hex          # stable random salt for browser-safe patient references
AUTH_MODE=api_key                                 # local synthetic demo only; use oidc for deployed user access
OIDC_ISSUER=https://identity.example.com/tenant/v2.0
OIDC_AUDIENCE=api://care-transition-api
OIDC_JWKS_URL=https://identity.example.com/tenant/discovery/v2.0/keys
OIDC_ROLES_CLAIM=roles
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_SECONDS=600
MAX_REQUEST_BYTES=1000000
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_ASSESSMENT_PER_MINUTE=30
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
ENVIRONMENT=development                        # development | staging | production

# ── Synthetic Data ───────────────────────────────────────────
SYNTHEA_OUTPUT_DIR=./data/raw
SYNTHEA_POPULATION_SIZE=500

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080        # if using React/Vite
VITE_AUTH_MODE=api_key                            # local synthetic demo only; use oidc for deployed user access
VITE_API_KEY=replace_with_same_value_as_API_KEY   # visible in browser builds; never use for production secrets
VITE_HISTORY_TIMEOUT_MS=120000
VITE_ASSESSMENT_TIMEOUT_MS=120000
VITE_CHAT_TIMEOUT_MS=120000
VITE_CLINICIAN_ID=demo_clinician
VITE_OIDC_AUTHORITY=https://identity.example.com/tenant/v2.0
VITE_OIDC_CLIENT_ID=your_spa_client_id
VITE_OIDC_SCOPE=openid profile api://care-transition-api/access_as_user
VITE_OIDC_ROLES_CLAIM=roles
# STREAMLIT_SERVER_PORT=8501                    # if using Streamlit instead

# ── Observability (optional for MVP, wire up when ready) ─────
GRAFANA_URL=
PROMETHEUS_PUSHGATEWAY_URL=
LOG_LEVEL=INFO

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=care-transition-copilot-dev
